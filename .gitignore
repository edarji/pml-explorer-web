# Entornos y cachés
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
*.log

# Credenciales y configuración local
.env
.env.*
.streamlit/secrets.toml
*.pem
*.key
*.p12
*.pfx
config/
deploy/

# Bases operativas y descargas de trabajo
*.duckdb
*.duckdb.*
*.db
*.sqlite*
*.parquet
*.csv
*.json.gz
# Solo el pipeline de Claude / pml-bot escribe y versiona estos derivados.
# Las excepciones permiten el particionado aprobado, sin permitir otros Parquet.
data/**
!data/README.md
!data/public/
!data/public/.gitkeep
!data/hourly/
!data/hourly/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].parquet
!data/daily/
!data/daily/[0-9][0-9][0-9][0-9]-[0-9][0-9].parquet
!data/nodes.parquet
!data/metadata.json

# v0.6.0 · Catálogo de NodosP: datos de referencia publicados por PR (no por pml-bot).
!referencia/
!referencia/nodos_catalogo.parquet
!referencia/nodos_catalogo.json

# v0.7.0 · PND: paquete público (contrato PND v1) generado por power-market-lab y publicado por PR.
# Mismo criterio que data/: solo el particionado aprobado, ningún otro Parquet.
pnd/**
!pnd/hourly/
!pnd/hourly/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].parquet
!pnd/zonas.parquet
!pnd/metadata.json

# GT v0.1 · Guatemala (edarji/edarji.net#8): paquete gt-1 del POE del AMM generado por power-market-lab
# (scripts/gt_publico.py). Solo los cuatro archivos del contrato; ningún otro Parquet.
gt/**
!gt/poe_horario.parquet
!gt/poe_diario.parquet
!gt/poe_mensual.parquet
!gt/metadata.json
